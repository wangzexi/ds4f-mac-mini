+/* SSD target spans change frequently. Keep views belonging to the DSpark
+ * support model while replacing only the target model's active spans. */
+static void ds4_gpu_model_views_clear_for_model(
+        const void *model_map,
+        uint64_t    model_size) {
+    uint32_t out = 0;
+    for (uint32_t i = 0; i < g_model_view_count; i++) {
+        if (g_model_views[i].model_map == model_map &&
+            g_model_views[i].model_size == model_size) {
+            g_model_views[i].buffer = nil;
+            g_model_views[i].model_map = NULL;
+            g_model_views[i].model_size = 0;
+            g_model_views[i].model_offset = 0;
+            g_model_views[i].bytes = 0;
+            continue;
+        }
+        if (out != i) {
+            g_model_views[out].buffer = g_model_views[i].buffer;
+            g_model_views[out].model_map = g_model_views[i].model_map;
+            g_model_views[out].model_size = g_model_views[i].model_size;
+            g_model_views[out].model_offset = g_model_views[i].model_offset;
+            g_model_views[out].bytes = g_model_views[i].bytes;
+            g_model_views[i].buffer = nil;
+            g_model_views[i].model_map = NULL;
+            g_model_views[i].model_size = 0;
+            g_model_views[i].model_offset = 0;
+            g_model_views[i].bytes = 0;
+        }
+        out++;
+    }
+    g_model_view_count = out;
+}
