+uint32_t ds4_gpu_stream_expert_cache_resident_mask(
+        const ds4_gpu_stream_expert_table *table,
+        const int32_t                     *selected_ids,
+        uint32_t                           n_selected) {
+    if (!g_ssd_streaming_mode || !table || !selected_ids ||
+        table->layer >= DS4_METAL_STREAM_EXPERT_CACHE_MAX_LAYER ||
+        n_selected == 0 || n_selected > 32u ||
+        table->n_total_expert == 0 ||
+        table->n_total_expert > DS4_METAL_STREAM_EXPERT_CACHE_MAX_EXPERT) {
+        return 0;
+    }
 
+    uint32_t mask = 0;
+    for (uint32_t i = 0; i < n_selected; i++) {
+        if (selected_ids[i] < 0 ||
+            (uint32_t)selected_ids[i] >= table->n_total_expert) {
+            continue;
+        }
+        const uint64_t expert = (uint64_t)(uint32_t)selected_ids[i];
+        if (expert > UINT64_MAX / table->gate_expert_bytes ||
+            expert > UINT64_MAX / table->down_expert_bytes) {
+            continue;
+        }
+        const uint64_t gate_rel = expert * table->gate_expert_bytes;
+        const uint64_t down_rel = expert * table->down_expert_bytes;
+        if (gate_rel > UINT64_MAX - table->gate_offset ||
+            gate_rel > UINT64_MAX - table->up_offset ||
+            down_rel > UINT64_MAX - table->down_offset) {
+            continue;
+        }
+        const ds4_gpu_stream_expert_cache_entry *entry =
+            &g_stream_expert_cache[table->layer][(uint32_t)selected_ids[i]];
+        if (ds4_gpu_stream_expert_cache_entry_matches(
+                    entry,
+                    table->model_map,
+                    table->model_size,
+                    table->gate_offset + gate_rel,
+                    table->up_offset + gate_rel,
+                    table->down_offset + down_rel,
+                    table->gate_expert_bytes,
+                    table->down_expert_bytes)) {
+            mask |= 1u << i;
+        }
+    }
+    return mask;
