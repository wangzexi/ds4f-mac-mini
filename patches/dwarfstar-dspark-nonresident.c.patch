+static bool dspark_ssd_nonresident_enabled(void) {
+    const char *value = getenv("DS4_DSPARK_SSD_NONRESIDENT");
+    return value && value[0] && strcmp(value, "0") != 0;
+}
+
+static bool dspark_model_map_nonexpert_spans(
+        const ds4_dspark_weights *dw,
+        ds4_model_map_span_vec   *spans) {
+    if (!dw || !spans || dw->n_stages == 0 ||
+        dw->n_stages > DS4_DSPARK_MAX_STAGES) {
+        return false;
+    }
+    memset(spans, 0, sizeof(*spans));
+    for (uint32_t stage = 0; stage < dw->n_stages; stage++) {
+        const ds4_dspark_stage_weights *sw = &dw->stage[stage];
+        model_map_span_vec_include_layer_decode_static(spans, &sw->block);
+        if (stage == 0) {
+            model_map_span_vec_include_one(spans, sw->main_proj);
+            model_map_span_vec_include_one(spans, sw->main_norm);
+        }
+        if (stage + 1u == dw->n_stages) {
+            model_map_span_vec_include_one(spans, sw->norm);
+            model_map_span_vec_include_one(spans, sw->hc_head_base);
+            model_map_span_vec_include_one(spans, sw->hc_head_fn);
+            model_map_span_vec_include_one(spans, sw->hc_head_scale);
+            model_map_span_vec_include_one(spans, sw->markov_w1);
+            model_map_span_vec_include_one(spans, sw->markov_w2);
+            model_map_span_vec_include_one(spans, sw->confidence_proj);
+        }
+    }
+    return model_map_span_vec_finish(spans);
+}
