+static bool metal_graph_install_dspark_nonexpert_views(
+        const ds4_model          *model,
+        const ds4_dspark_weights *dw) {
+    ds4_model_map_span_vec spans;
+    if (!model || !dspark_model_map_nonexpert_spans(dw, &spans)) return false;
+    const uint64_t total_bytes = model_map_span_vec_total_bytes(&spans);
+    bool ok = true;
+    for (uint32_t i = 0; ok && i < spans.len; i++) {
+        const uint64_t span_bytes = spans.v[i].end - spans.v[i].off;
+        ok = ds4_gpu_set_model_map_range(model->map,
+                                         model->size,
+                                         spans.v[i].off,
+                                         span_bytes,
+                                         span_bytes) != 0;
+    }
+    if (ok) {
+        fprintf(stderr,
+                "ds4: DSpark SSD nonresident support map: %u spans, %.2f GiB non-expert weights\n",
+                spans.len,
+                (double)total_bytes / 1073741824.0);
+    } else {
+        fprintf(stderr, "ds4: DSpark SSD nonresident support map failed\n");
+    }
+    free(spans.v);
+    return ok;
+}
